# Backend environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Strong random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-value

# Local development (MongoDB Community installed on this machine)
MONGO_URI=mongodb://127.0.0.1:27017/quizapp

# MongoDB Atlas (production) example:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/quizapp?retryWrites=true&w=majority

# Comma-separated extra CORS origins (e.g. your Vercel frontend URL)
# CORS_ORIGINS=https://twoj-frontend.vercel.app

PORT=3000
