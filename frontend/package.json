{
  "name": "quiz-app-frontend",
  "version": "1.0.0",
  "description": "Frontend for the Quiz Application built with Vue.js",
  "main": "src/main.js",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "vite build && gh-pages -d dist",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{js,vue,css,scss,json,md}\""
  },
  "dependencies": {
