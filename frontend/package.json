    "vue-virtual-scroller": "^2.0.0-beta.8",
    "vuex": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^9.30.0",
    "eslint-plugin-vue": "^10.2.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.2.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.5",
    "vite": "^6.4.6",
